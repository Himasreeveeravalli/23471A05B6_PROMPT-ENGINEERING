import time
import google.generativeai as genai

model = genai.GenerativeModel("gemini-3.5-flash")

for i in range(5):
    try:
        response = model.generate_content(
            "Write a one-paragraph bio of Ada Lovelace."
        )
        print(response.text)
        break
    except Exception as e:
        print(e)
        print("Waiting 60 seconds...")
        time.sleep(60)
